# --- Mode -----------------------------------------------------------------
# true = simulated devices from devices.demo.yaml and 7 days of generated history.
DEMO_MODE=true
# Device list. Empty = devices.demo.yaml in demo mode, devices.yaml otherwise.
DEVICES_FILE=

# --- Telegram -------------------------------------------------------------
# Leave empty to print alerts in the console.
BOT_TOKEN=
# Chat that receives alerts (group ids start with -100).
ALERT_CHAT_ID=

# --- Checks ---------------------------------------------------------------
CHECK_INTERVAL_S=60
# Interval in demo mode, so you see changes quickly.
DEMO_INTERVAL_S=5
# Failed rounds in a row before a device is DOWN (1 lost ping is not an outage).
FAIL_AFTER=2
# Good rounds in a row before it is UP again (stops alert spam from flapping devices).
RECOVER_AFTER=2
PING_TIMEOUT_S=1
# Keep it at 3 or more on Windows: it reports a refused port only after ~2 s, and a
# shorter timeout would show "timed out" instead of "connection refused".
TCP_TIMEOUT_S=3

# --- Storage and status page ----------------------------------------------
DATABASE_PATH=data/uptime.db
RETENTION_DAYS=8
HOST=0.0.0.0
PORT=8000
TIMEZONE=Europe/Istanbul
